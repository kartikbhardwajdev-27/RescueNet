# Laptop mode. For the hosted site the same two names are set in Vercel (docs/DEPLOY.md).
MONGODB_URI=mongodb://127.0.0.1:27017/rescuenet
# At least 32 characters or the server refuses to start logins. Make one with: openssl rand -hex 32
JWT_SECRET=change_me

# Optional (the defaults are right for the laptop and for Vercel):
# COOKIE_SECURE=true|false          force the login cookie Secure on or off (default: Secure only over https)
# RATE_LIMIT_STORE=memory|mongo     default: memory for a local database, mongo otherwise
# MONGODB_MAX_POOL=5                connections per server process (default 5)
